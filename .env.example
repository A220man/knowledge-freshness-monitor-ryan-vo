# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DATABASE_URL=sqlite:///./knowledge_freshness.db

# Authentication / OIDC (Keycloak)
AUTH_METHOD=demo
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/knowledge-freshness
OIDC_CLIENT_ID=knowledge-freshness-app
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
SESSION_COOKIE_NAME=kfm_session
COOKIE_SECURE=false

# LLM Advisory Provider Settings (Optional Non-Secret Configuration)
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen3.8-27b
LLM_BASE_URL=https://llm.chris-vo.com/v1
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=15
